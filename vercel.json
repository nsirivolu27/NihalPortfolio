{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "artifacts/portfolio-site/dist/public",
  "redirects": [
    {
      "source": "/:path((?!api(?:/|$)|\\.well-known(?:/|$)).*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "destination": "https://nihalsirivolu.com/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!\\.well-known(?:/|$)).*)",
      "has": [{ "type": "host", "value": "www.nihalsirivolu.com" }],
      "destination": "https://nihalsirivolu.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/featured", "destination": "/index.html" },
    { "source": "/projects", "destination": "/index.html" },
    { "source": "/certifications", "destination": "/index.html" },
    { "source": "/writing", "destination": "/index.html" },
    { "source": "/music", "destination": "/index.html" },
    { "source": "/investing", "destination": "/index.html" },
    { "source": "/investing/sync", "destination": "/index.html" }
  ]
}
