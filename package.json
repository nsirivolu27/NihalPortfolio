{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "test": "node --experimental-strip-types scripts/test-portfolio.mjs && node --experimental-strip-types scripts/test-blog-feed.mjs",
    "sync:content": "node --experimental-strip-types scripts/sync-public-content.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "start:investing": "node scripts/start-investing.mjs",
    "test:api": "node scripts/test-investing-api.mjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
